# Legacy Ecom Brasil (prioridade sobre Mercado Pago)
# Docs: https://developer.selagyccecombrasil.com/docs/sonic-payments
LEGACY_PUBLIC_KEY=pk_live_xxx
LEGACY_SECRET_KEY=sk_live_xxx
# LEGACY_WEBHOOK_URL=https://seudominio.com/api/webhooks/legacy

# Mercado Pago (fallback se Legacy nao configurada)
MERCADOPAGO_ACCESS_TOKEN=

# URL publica do app (webhook Legacy + links)
PUBLIC_APP_URL=http://localhost:8080

# Painel admin
ADMIN_PASSWORD=admin123
# ADMIN_SECRET=opcional-segredo-para-token

# Webhooks Pushcut (persistem em producao no Lovable)
# Opcao 1: URL unica para venda pendente e aprovada
# PUSHCUT_WEBHOOK_URL=https://api.pushcut.io/xxx/seu-webhook
#
# Opcao 2: JSON completo (array de webhooks)
# ADMIN_WEBHOOKS_JSON=[{"id":"1","url":"https://api.pushcut.io/...","events":["venda_pendente","venda_aprovada"],"active":true}]
#
# Opcao 3 (recomendado Lovable): Upstash Redis gratis para salvar pelo admin
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxx
